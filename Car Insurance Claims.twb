            <column caption='Metric Parameter' datatype='string' name='[Parameter 1725186672295942]' param-domain-type='list' role='measure' type='nominal' value='&quot;Average Claim Amount&quot;'>
              <calculation class='tableau' formula='&quot;Average Claim Amount&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0mt9nqn01rx8gv17b1q7n15ad0q9'>
            <column caption='Bluebook' datatype='integer' name='[BLUEBOOK]' role='measure' type='quantitative' />
            <column caption='Car Type' datatype='string' name='[CAR_TYPE]' role='dimension' type='nominal' />
