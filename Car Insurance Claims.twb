            <column caption='Selected Metric' datatype='real' name='[Calculation_1725186672562183]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1725186672295942]&#13;&#10;&#13;&#10;WHEN &quot;Average Claim Amount&quot;&#13;&#10;THEN AVG([CLM_AMT])&#13;&#10;&#13;&#10;WHEN &quot;Average Income&quot;&#13;&#10;THEN AVG([INCOME])&#13;&#10;&#13;&#10;WHEN &quot;Average Car Value&quot;&#13;&#10;THEN AVG([BLUEBOOK])&#13;&#10;&#13;&#10;WHEN &quot;Average Previous Claim&quot;&#13;&#10;THEN AVG([OLDCLAIM])&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Education' datatype='string' name='[EDUCATION]' role='dimension' type='nominal' />
