      <column caption='Clm Freq' datatype='integer' name='[CLM_FREQ]' role='measure' type='quantitative' />
      <column caption='Claim Risk Segment' datatype='string' name='[Calculation_1233430818603008]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [CLM_AMT] &gt; 0 AND [CLM_FREQ] &gt;= 2 THEN &quot;High Claim Risk&quot;&#13;&#10;ELSEIF [CLM_AMT] &gt; 0 THEN &quot;Claimed&quot;&#13;&#10;ELSE &quot;No Claim&quot;&#13;&#10;END' />
      </column>
      <column caption='Age' datatype='integer' name='[Calculation_1725186669793280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;,[BIRTH],TODAY())' />
      </column>
      <column caption='Age Group' datatype='string' name='[Calculation_1725186670268418]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1725186669793280] &lt; 50 THEN &quot;40-49&quot;&#13;&#10;ELSEIF [Calculation_1725186669793280] &lt; 60 THEN &quot;50-59&quot;&#13;&#10;ELSEIF [Calculation_1725186669793280] &lt; 70 THEN &quot;60-69&quot;&#13;&#10;ELSEIF [Calculation_1725186669793280] &lt; 80 THEN &quot;70-79&quot;&#13;&#10;ELSEIF [Calculation_1725186669793280] &lt; 90 THEN &quot;80-89&quot;&#13;&#10;ELSE &quot;90+&quot;&#13;&#10;END' />
      </column>
      <column caption='Claim Status' datatype='string' name='[Calculation_1725186670436355]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [CLM_AMT] &gt; 0 THEN &quot;Claimed&quot;&#13;&#10;ELSE &quot;No Claim&quot;&#13;&#10;END' />
      </column>
      <column caption='Education Filter' datatype='boolean' name='[Calculation_1725186671534085]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1725186670649348] = &quot;All&quot;&#13;&#10;THEN TRUE&#13;&#10;ELSE [EDUCATION] = [Parameters].[Parameter 1725186670649348]&#13;&#10;END' />
      </column>
      <column caption='Selected Metric' datatype='real' name='[Calculation_1725186672562183]' role='measure' type='quantitative'>
