    <dashboard enable-sort-zone-taborder='true' name='summary 01'>
      <style />
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone forceUpdate='true' h='6026' id='3' type-v2='text' w='99062' x='469' y='824'>
            <formatted-text>
              <run fontalignment='1' fontcolor='#555555' fontname='Wide Latin' fontsize='15'>Executive Summary</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='8982' id='5' layout-strategy-id='distribute-evenly' param='horz' type-v2='layout-flow' w='99062' x='469' y='6850'>
            <zone h='8960' id='6' name='Customers' show-title='false' w='19859' x='469' y='6900'>
              <layout-cache fixed-size-h='105' fixed-size-w='140' type-h='fixed' type-w='fixed' />
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='8960' id='11' name='Customers with Claims ' show-title='false' w='19801' x='20328' y='6900'>
              <layout-cache fixed-size-w='220' type-h='fixed' type-w='fixed' />
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='8960' id='7' name='Claim Rate' show-title='false' w='19801' x='40129' y='6900'>
              <layout-cache fixed-size-w='160' type-h='fixed' type-w='fixed' />
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='8960' id='9' name='Average Claim Amount' show-title='false' w='19801' x='59930' y='6900'>
              <layout-cache fixed-size-w='220' type-h='fixed' type-w='fixed' />
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone h='8960' id='10' name='Average Vehicle Value' show-title='false' w='19800' x='79731' y='6900'>
              <layout-cache fixed-size-w='220' type-h='fixed' type-w='fixed' />
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
          </zone>
          <zone forceUpdate='true' h='25355' id='12' type-v2='text' w='49501' x='50030' y='15832'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontname='Cambria' fontsize='14'>2. </run>
              <run bold='true' fontcolor='#000000' fontname='Cambria' fontsize='14' underline='true'>Customer Profile &amp; Age Distribution</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Cambria' fontsize='12'>Summary Points</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>The customer base is concentrated mainly in the 60–89 age range. </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>The 70–79 age group represents the largest customer segment. </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Cambria' fontsize='12'>Insights</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>Older age groups form a significant portion of the customer base, indicating a relatively mature customer population. </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>The smaller 90+ segment represents a comparatively limited customer group. </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Cambria' fontsize='12'>Recommendations</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>Use age groups as one factor for targeted customer communication and service strategies. </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>Develop customer segments using age along with gender, marital status and vehicle usage rather than age alone.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='25355' id='13' type-v2='text' w='49561' x='469' y='15832'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontname='Cambria' fontsize='14'>1. </run>
              <run bold='true' fontcolor='#000000' fontname='Cambria' fontsize='14' underline='true'>Customer &amp; Vehicle Overview</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Cambria' fontsize='12'>Summary Points</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>The dataset contains customers with diverse vehicle types, vehicle usage patterns, income levels and occupations. </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>Private vehicle usage represents the majority of customers, while income varies considerably across occupations. </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Cambria' fontsize='12'>Insights</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>Minivans and SUVs represent some of the larger customer groups by car type. </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>Doctors, Managers and Lawyers have higher average income compared with other occupation groups. </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Cambria' fontsize='12'>Recommendations</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>Use customer, financial and vehicle characteristics together for deeper segmentation. </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>Use the EDA findings as a foundation for further claim-risk and customer-value analysis. </run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone forceUpdate='true' h='31269' id='14' type-v2='text' w='49561' x='469' y='41187'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontname='Cambria' fontsize='14'>3. </run>
              <run bold='true' fontcolor='#000000' fontname='Cambria' fontsize='14' underline='true'>Education &amp; Income Profile</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Cambria' fontsize='12'>Summary Points</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>Average income increases substantially as education level increases. </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>Customers with Masters and PhD qualifications have the highest average income levels. </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Cambria' fontsize='12'>Insights</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>Education level is strongly associated with differences in customer income. </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>Lower-education groups represent customers with comparatively lower average income. </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Cambria' fontsize='12'>Recommendations</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>Use education and income together for customer segmentation and targeted campaigns. </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>Design suitable insurance products and communication strategies for different income segments.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='31269' id='15' type-v2='text' w='49501' x='50030' y='41187'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontname='Cambria' fontsize='14'>4. </run>
              <run bold='true' fontcolor='#000000' fontname='Cambria' fontsize='14' underline='true'>Vehicle Age &amp; Claim Frequency</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Cambria' fontsize='12'>Summary Points</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>Vehicle age has only a weak relationship with claim frequency. </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>Claim frequency remains relatively similar across different vehicle-age ranges. </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Cambria' fontsize='12'>Insights</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>Older vehicles do not consistently show higher claim frequency in this dataset. </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>Vehicle age alone is not a strong indicator of customer claim behaviour. </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Cambria' fontsize='12'>Recommendations</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>Avoid using vehicle age as the sole factor for assessing insurance risk. </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>Combine vehicle age with vehicle use, car type and previous claim history for better risk assessment.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone h='26720' id='16' type-v2='text' w='49527' x='469' y='72456'>
            <formatted-text>
              <run bold='true' fontcolor='#000000' fontname='Cambria' fontsize='14'>5.</run>
              <run fontcolor='#000000' fontname='Cambria' fontsize='14'>Æ </run>
              <run bold='true' fontcolor='#000000' fontname='Cambria' fontsize='14' underline='true'>Claim Amount &amp; Risk</run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Cambria' fontsize='12'>Summary Points</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>Commercial customers have higher average claim amounts than Private customers. </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>Claim amounts also vary across gender and car type. </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Cambria' fontsize='12'>Insights</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>Commercial vehicle usage represents a higher claim-cost segment than Private usage. </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>Some car types contribute substantially to the overall claim amount. </run>
              <run>Æ&#10;</run>
              <run bold='true' fontcolor='#000000' fontname='Cambria' fontsize='12'>Recommendations</run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>Review commercial vehicle pricing and risk assessment separately from Private vehicle policies. </run>
              <run>Æ&#10;</run>
              <run fontcolor='#000000' fontname='Cambria'>Use car type and claim history to identify higher-cost risk segments and improve pricing decisions. </run>
              <run>Æ&#10;&#10;&#10;</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
