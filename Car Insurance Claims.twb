  <dashboards>
    <dashboard name='Car Insurance Claim' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Cooper Black' fontsize='15'>Customer &amp; Vehicle Overview</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='story-point-caption'>
          <format attr='width' value='1420' />
        </style-rule>
      </style>
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98352' id='11' param='vert' removable='false' type-v2='layout-flow' w='99062' x='469' y='824'>
            <zone h='98352' id='1' param='vert' removable='false' type-v2='layout-flow' w='99062' x='469' y='824'>
              <zone fixed-size='93' h='9578' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='99062' x='469' y='824' />
              <zone h='88774' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='99062' x='469' y='10402'>
                <flipboard active-id='6' nav-type='caption' show-nav-arrows='true'>
                  <story-points>
                    <story-point caption='The customer base shows diverse vehicle types, usage patterns, income levels and occupations. Private vehicle usage is dominant, while customer income varies considerably across occupations.' captured-sheet='Exploring the Dataset' id='1'>
                      <capturedDeltas>
                        <worksheet name='EDA - Car Type Distribution'>
                          <filter class='categorical' column='[federated.0mt9nqn01rx8gv17b1q7n15ad0q9].[Action (Car Use)]'>
                            <groupfilter function='level-members' level='[CAR_USE]' user:ui-enumeration='all' user:ui-marker='enumerate' />
                          </filter>
                        </worksheet>
                        <worksheet name='EDA - Car Use Mix'>
                          <filter class='categorical' column='[federated.0mt9nqn01rx8gv17b1q7n15ad0q9].[Action (Car Type)]'>
                            <groupfilter function='level-members' level='[CAR_TYPE]' user:ui-enumeration='all' user:ui-marker='enumerate' />
                          </filter>
                        </worksheet>
                        <worksheet name='EDA - Home Value vs Income'>
                          <filter class='categorical' column='[federated.0mt9nqn01rx8gv17b1q7n15ad0q9].[Action (Car Type)]'>
                            <groupfilter function='level-members' level='[CAR_TYPE]' user:ui-enumeration='all' user:ui-marker='enumerate' />
                          </filter>
                          <filter class='categorical' column='[federated.0mt9nqn01rx8gv17b1q7n15ad0q9].[Action (Car Use)]'>
                            <groupfilter function='level-members' level='[CAR_USE]' user:ui-enumeration='all' user:ui-marker='enumerate' />
                          </filter>
                        </worksheet>
                        <worksheet name='EDA - Income Distribution'>
                          <filter class='categorical' column='[federated.0mt9nqn01rx8gv17b1q7n15ad0q9].[Action (Car Type)]'>
                            <groupfilter function='level-members' level='[CAR_TYPE]' user:ui-enumeration='all' user:ui-marker='enumerate' />
                          </filter>
                          <filter class='categorical' column='[federated.0mt9nqn01rx8gv17b1q7n15ad0q9].[Action (Car Use)]'>
                            <groupfilter function='level-members' level='[CAR_USE]' user:ui-enumeration='all' user:ui-marker='enumerate' />
                          </filter>
                        </worksheet>
                        <worksheet name='EDA - Occupation Income'>
                          <filter class='categorical' column='[federated.0mt9nqn01rx8gv17b1q7n15ad0q9].[Action (Car Type)]'>
                            <groupfilter function='level-members' level='[CAR_TYPE]' user:ui-enumeration='all' user:ui-marker='enumerate' />
                          </filter>
                          <filter class='categorical' column='[federated.0mt9nqn01rx8gv17b1q7n15ad0q9].[Action (Car Use)]'>
                            <groupfilter function='level-members' level='[CAR_USE]' user:ui-enumeration='all' user:ui-marker='enumerate' />
                          </filter>
                        </worksheet>
                      </capturedDeltas>
                    </story-point>
                    <story-point caption='The customer base is concentrated mainly between ages 60 and 89, with the 70–79 age group being the largest. This indicates a relatively mature customer population.' captured-sheet='KQ1_Dashboard 1 - Driver Profile' id='2' />
                    <story-point caption='Average income increases substantially with education level, with Masters and PhD customers having the highest average income. Education therefore provides a useful basis for understanding customer financial segments.' captured-sheet='KQ2_Dashboard 2 - Education &amp; Income' id='3' />
                    <story-point caption='Vehicle age shows only a weak relationship with claim frequency, with no clear increase in claims as vehicles become older. Therefore, vehicle age alone is not a strong indicator of claim behaviour.' captured-sheet='KQ3_Dashboard 3 - Vehicle Age &amp; Claims' id='4' />
                    <story-point caption='Commercial customers show higher average claim amounts than Private customers, with additional differences across gender and car type. This highlights Commercial usage as an important segment for claim-cost management.' captured-sheet='Dashboard 4 - Claim Risk' id='5'>
                      <capturedDeltas>
                        <worksheet name='EDA - Claims Pareto by Car Type'>
                          <filter class='categorical' column='[federated.0mt9nqn01rx8gv17b1q7n15ad0q9].[Action (Claim Risk Segment)]'>
                            <groupfilter function='level-members' level='[Calculation_1233430818603008]' user:ui-enumeration='all' user:ui-marker='enumerate' />
                          </filter>
                        </worksheet>
                        <worksheet name='KQ4 - Claim Amount by Car Use'>
                          <filter class='categorical' column='[federated.0mt9nqn01rx8gv17b1q7n15ad0q9].[Action (Claim Risk Segment)]'>
                            <groupfilter function='level-members' level='[Calculation_1233430818603008]' user:ui-enumeration='all' user:ui-marker='enumerate' />
                          </filter>
                        </worksheet>
                        <worksheet name='KQ4 - Claim Amount by Gender'>
                          <filter class='categorical' column='[federated.0mt9nqn01rx8gv17b1q7n15ad0q9].[Action (Claim Risk Segment)]'>
                            <groupfilter function='level-members' level='[Calculation_1233430818603008]' user:ui-enumeration='all' user:ui-marker='enumerate' />
                          </filter>
                        </worksheet>
                      </capturedDeltas>
                    </story-point>
                    <story-point caption='Vehicle value varies significantly across car types, with Panel Trucks having the highest average BLUEBOOK value. Married customers form the majority across the different vehicle categories.' captured-sheet='KQ5_Dashboard 5 - Vehicle Value &amp; Customer Profile' id='6' />
                    <story-point caption='The analysis highlights meaningful differences in customer profiles, vehicle characteristics and claim behaviour. A multi-factor approach using vehicle use, car type, income, education, vehicle value and claim history can support better segmentation, pricing and risk management.' captured-sheet='summary 01' id='7' />
                  </story-points>
                </flipboard>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
